            </column>
            <column name="color" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="anio" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="precio" type="decimal(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="transmision" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
